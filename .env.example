# Copy this file to .env (never commit .env) and fill in your own values.
# Spring Boot does NOT read .env files by itself. Ways to use it:
#   * IntelliJ:   Run -> Edit Configurations -> Environment variables (paste NAME=value;NAME=value), or the "EnvFile" plugin
#   * Docker:     docker run --env-file .env ...
#   * PowerShell: $env:DB_PASSWORD = "..."   (applies to that PowerShell window only)
# On Railway you do NOT use this file: add the same names in the service "Variables" tab (see README).

# ---- MySQL (local: your MySQL Server from MySQL Workbench) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cabbooking_db
DB_USERNAME=root
DB_PASSWORD=<your-local-mysql-password>
# Optional: extra JDBC options. Default is useSSL=false&allowPublicKeyRetrieval=true
# DB_OPTIONS=useSSL=true&requireSSL=true

# ---- JWT ----
# Base64 text of at least 32 random bytes. Generate one in PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=<generate-your-own-base64-secret>
# Token lifetime in minutes (must be greater than 0; default 60)
JWT_EXPIRATION_MINUTES=60

# ---- First ADMIN account (created at startup if it does not exist yet) ----
ADMIN_USERNAME=<choose-an-admin-username>
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<choose-a-strong-password-min-8-chars>

# ---- Optional ----
# "prod" = production settings (the Docker image already sets this). Leave empty for local development.
# SPRING_PROFILES_ACTIVE=prod
# PORT is set by Railway automatically. Locally the app uses 8080.
